# ==========================================
# CUSTOM LAPTOP E-COMMERCE PLATFORM ENV CONFIG
# ==========================================

# -----------------
# FRONTEND (apps/web)
# -----------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=laptop-store
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=store-frontend
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_sample_key_here

# -----------------
# BACKEND (apps/api)
# -----------------
PROJECT_NAME="Custom Laptop Store API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-key-change-in-production-min-32-chars"
ENVIRONMENT="development"
DEBUG=True

# Database & Cache
DATABASE_URL=sqlite+aiosqlite:///./laptop_store.db
SYNC_DATABASE_URL=sqlite:///./laptop_store.db
REDIS_URL=redis://localhost:6379/0

# Keycloak Auth
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=laptop-store
KEYCLOAK_CLIENT_ID=store-backend
KEYCLOAK_CLIENT_SECRET=sample_client_secret_here

# Payments
PAYSTACK_SECRET_KEY=sk_test_sample_key_here
FLUTTERWAVE_SECRET_KEY=flw_test_sample_key_here

# Storage (S3 / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=laptop-store-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
